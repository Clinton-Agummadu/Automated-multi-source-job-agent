      "parameters": {
        "jsCode": "// Safely locate fields regardless of Webhook structure\nconst body = $json.body || $json;\nconst data = body.data || body;\nconst fields = data.fields || [];\n\n// Helper function to extract value or readable option text by label keyword\nfunction getAnswer(labelKey) {\n  const item = fields.find(f => f.label && f.label.toLowerCase().includes(labelKey.toLowerCase()));\n  if (!item) return '';\n\n  // If the field has a dropdown/multiple choice value (ID) and an options array\n  if (Array.isArray(item.options) && item.value) {\n    const selectedOption = item.options.find(opt => opt.id === item.value || (Array.isArray(item.value) && item.value.includes(opt.id)));\n    if (selectedOption) return selectedOption.text;\n  }\n\n  // Fallback to value if it's plain text/number\n  return item.value || '';\n}\n\nreturn {\n  json: {\n    name: getAnswer('Name'),\n    company: getAnswer('Company'),\n    email: getAnswer('Email'),\n    service: getAnswer('Service'),\n    budget: getAnswer('Value') || getAnswer('Contract')\n  }\n};"
      },
